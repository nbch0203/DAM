<?xml version="1.0" encoding="utf-8"?>
<!-- Nixon Bolivar Cruz Hidalgo -->

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".QueryActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Realizar consultas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Fila: EditText nombre BD + botón seleccionar -->
    <EditText
        android:id="@+id/etDatabaseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nombre de la BD"
        android:inputType="text"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSelectDB"
        app:layout_constraintHorizontal_bias="0.0" />

    <Button
        android:id="@+id/btnSelectDB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar BD"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/etDatabaseName"
        app:layout_constraintStart_toEndOf="@id/etDatabaseName"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Área de consulta -->
    <EditText
        android:id="@+id/etQuery"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:hint="Ingresa consulta SQL"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etDatabaseName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botones de acción en fila (izquierda / derecha) -->
    <Button
        android:id="@+id/btnExecuteQuery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejecutar"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etQuery"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etQuery"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Resultado: ocupa el espacio restante -->
    <TextView
        android:id="@+id/tvResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:background="#f0f0f0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnExecuteQuery"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>