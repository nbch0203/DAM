<Window x:Class="Cine_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cinema App" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Cargar Peliculas"
                Click="onclick" Margin="10" Padding="10,5"/>

        <DataGrid Grid.Row="1" x:Name="dgPeliculas"
                  AutoGenerateColumns="True" Margin="10"
                  SelectionChanged="DataGrid_SelectionChanged"/>
    </Grid>
</Window>