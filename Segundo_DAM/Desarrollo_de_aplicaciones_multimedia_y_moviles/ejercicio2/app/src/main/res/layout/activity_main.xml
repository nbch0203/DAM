<?xml version="1.0" encoding="utf-8"?>
<!-- Nixon Bolivar Cruz Hidalgo -->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/etDatabaseName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre de la base de datos" />

    <Button
        android:id="@+id/btnCreateDB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crear BD" />

    <EditText
        android:id="@+id/etSQL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sentencia SQL" />

    <Button
        android:id="@+id/btnExecuteSQL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejecutar SQL" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultados"
        android:paddingTop="16dp" />

</LinearLayout>
